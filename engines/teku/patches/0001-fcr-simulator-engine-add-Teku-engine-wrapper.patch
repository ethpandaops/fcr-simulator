+  private final HttpClient httpClient;
+
+  public SlotInstructionFetcher(final HttpClient httpClient) {
+    this.httpClient = httpClient;
+  }
+
+  public SlotInstruction fetch(final UInt64 simSlot, final UInt64 warmupStartSlot)
+      throws IOException, InterruptedException {
+    final String path =
+        "/fcr-sim/v1/slot/"
+            + HttpClient.queryParam(simSlot)
+            + "?warmup_start_slot="
+            + HttpClient.queryParam(warmupStartSlot);
+    final JsonNode root = OBJECT_MAPPER.readTree(httpClient.getJson(path));
+    final JsonNode version = root.get("version");
+    if (version == null || version.isNull()) {
+      throw new IOException("slot instruction response is missing version");
+    }
+    if (!version.isIntegralNumber() || version.asLong() != 3) {
+      throw new IOException(
+          "unsupported slot instruction version " + version.asText() + "; expected 3");
+    }
+
+    final JsonNode slot = required(root, "slot");
+    final UInt64 responseSimSlot = parseUInt64(required(slot, "sim_slot"), "slot.sim_slot");
+    if (!responseSimSlot.equals(simSlot)) {
+      throw new IOException(
+          "slot instruction response sim_slot mismatch: requested "
+              + simSlot
+              + ", got "
+              + responseSimSlot);
+    }
+
+    return new SlotInstruction(
+        responseSimSlot,
+        parseUInt64(required(slot, "eval_slot"), "slot.eval_slot"),
+        parseImportBlocks(required(slot, "import_blocks")),
+        parseAttestations(required(slot, "attestations")));
+  }
+
+  private static List<SlotInstruction.BlockImport> parseImportBlocks(final JsonNode blocks)
+      throws IOException {
+    if (!blocks.isArray()) {
+      throw new IOException("slot.import_blocks must be an array");
+    }
+    final List<SlotInstruction.BlockImport> result = new ArrayList<>();
+    for (final JsonNode block : blocks) {
+      result.add(
+          new SlotInstruction.BlockImport(
+              parseUInt64(required(block, "slot"), "import_blocks[].slot"),
+              parseRoot(required(block, "root"), "import_blocks[].root"),
+              parseBoolean(required(block, "canonical"), "import_blocks[].canonical")));
+    }
+    return result;
+  }
+
+  private static List<SlotInstruction.PlannedAttestation> parseAttestations(
+      final JsonNode attestations) throws IOException {
+    if (!attestations.isArray()) {
+      throw new IOException("slot.attestations must be an array");
+    }
+    final List<SlotInstruction.PlannedAttestation> result = new ArrayList<>();
+    for (final JsonNode attestation : attestations) {
+      result.add(
+          new SlotInstruction.PlannedAttestation(
+              parseBytes(
+                  required(attestation, "aggregation_bits"), "attestations[].aggregation_bits"),
+              parseOptionalBytes(
+                  attestation.get("committee_bits"), "attestations[].committee_bits"),
+              parseAttestationData(required(attestation, "data"))));
+    }
+    return result;
+  }
+
+  private static SlotInstruction.AttestationData parseAttestationData(final JsonNode data)
+      throws IOException {
+    return new SlotInstruction.AttestationData(
+        parseUInt64(required(data, "slot"), "attestations[].data.slot"),
+        parseUInt64(required(data, "index"), "attestations[].data.index"),
+        parseRoot(required(data, "beacon_block_root"), "attestations[].data.beacon_block_root"),
+        parseCheckpoint(required(data, "source"), "attestations[].data.source"),
+        parseCheckpoint(required(data, "target"), "attestations[].data.target"));
+  }
+
+  private static SlotInstruction.Checkpoint parseCheckpoint(
+      final JsonNode checkpoint, final String name) throws IOException {
+    return new SlotInstruction.Checkpoint(
+        parseUInt64(required(checkpoint, "epoch"), name + ".epoch"),
+        parseRoot(required(checkpoint, "root"), name + ".root"));
+  }
+
+  private static JsonNode required(final JsonNode node, final String field) throws IOException {
+    final JsonNode value = node.get(field);
+    if (value == null || value.isNull()) {
+      throw new IOException("slot instruction response is missing " + field);
+    }
+    return value;
+  }
+
+  private static UInt64 parseUInt64(final JsonNode node, final String name) throws IOException {
+    if (!node.isIntegralNumber()) {
+      throw new IOException("invalid uint64 for " + name + ": " + node.asText());
+    }
+    try {
+      return UInt64.valueOf(node.asText());
+    } catch (final IllegalArgumentException e) {
+      throw new IOException("invalid uint64 for " + name + ": " + node.asText(), e);
+    }
+  }
+
+  private static boolean parseBoolean(final JsonNode node, final String name) throws IOException {
+    if (!node.isBoolean()) {
+      throw new IOException("invalid boolean for " + name + ": " + node.asText());
+    }
+    return node.asBoolean();
+  }
+
+  private static Bytes32 parseRoot(final JsonNode node, final String name) throws IOException {
+    try {
+      return Bytes32.fromHexStringStrict(node.asText());
+    } catch (final IllegalArgumentException e) {
+      throw new IOException("invalid root for " + name + ": " + node.asText(), e);
+    }
+  }
+
+  private static Bytes parseBytes(final JsonNode node, final String name) throws IOException {
+    try {
+      return Bytes.fromHexString(node.asText());
+    } catch (final IllegalArgumentException e) {
+      throw new IOException("invalid bytes for " + name + ": " + node.asText(), e);
+    }
+  }
+
+  private static Optional<Bytes> parseOptionalBytes(final JsonNode node, final String name)
+      throws IOException {
+    if (node == null || node.isNull()) {
+      return Optional.empty();
+    }
+    return Optional.of(parseBytes(node, name));
+  }
+}
