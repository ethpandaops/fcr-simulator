+
+import com.fasterxml.jackson.annotation.JsonProperty;
+import com.fasterxml.jackson.annotation.JsonPropertyOrder;
+
+@JsonPropertyOrder({
+  "slot",
+  "epoch",
+  "has_block",
+  "block_root",
+  "head_root",
+  "confirmed_root",
+  "confirmed_slot",
+  "confirmation_delay_slots",
+  "fast_confirmed",
+  "strict_one_slot_confirmed",
+  "finalized_epoch",
+  "justified_epoch",
+  "source_block_slot",
+  "num_attestations_injected",
+  "is_epoch_boundary",
+  "is_missed_slot",
+  "fcr_eval_duration_us"
+})
+public record SlotResult(
+    @JsonProperty("slot") long slot,
+    @JsonProperty("epoch") long epoch,
+    @JsonProperty("has_block") boolean hasBlock,
+    @JsonProperty("block_root") String blockRoot,
+    @JsonProperty("head_root") String headRoot,
+    @JsonProperty("confirmed_root") String confirmedRoot,
+    @JsonProperty("confirmed_slot") long confirmedSlot,
+    @JsonProperty("confirmation_delay_slots") long confirmationDelaySlots,
+    @JsonProperty("fast_confirmed") boolean fastConfirmed,
+    @JsonProperty("strict_one_slot_confirmed") boolean strictOneSlotConfirmed,
+    @JsonProperty("finalized_epoch") long finalizedEpoch,
+    @JsonProperty("justified_epoch") long justifiedEpoch,
+    @JsonProperty("source_block_slot") Long sourceBlockSlot,
+    @JsonProperty("num_attestations_injected") int numAttestationsInjected,
+    @JsonProperty("is_epoch_boundary") boolean isEpochBoundary,
+    @JsonProperty("is_missed_slot") boolean isMissedSlot,
+    @JsonProperty("fcr_eval_duration_us") long fcrEvalDurationUs) {}
