+package tech.pegasys.teku.statetransition.forkchoice.fastconfirmation;
+
+import java.util.Optional;
+import org.apache.tuweni.bytes.Bytes32;
+import tech.pegasys.teku.infrastructure.unsigned.UInt64;
+import tech.pegasys.teku.spec.Spec;
+import tech.pegasys.teku.spec.datastructures.forkchoice.FastConfirmationStore;
+import tech.pegasys.teku.spec.datastructures.state.beaconstate.BeaconState;
+
+/** Public adapter allowing the simulator to execute the package-private fast confirmation rule. */
+public final class FastConfirmationSimulator {
+  private FastConfirmationSimulator() {}
+
+  public static FastConfirmationStore updateVariables(
+      final Spec spec,
+      final FastConfirmationStore store,
+      final UInt64 currentSlot,
+      final Bytes32 currentSlotHead) {
+    return FastConfirmationRuleUtil.updateFastConfirmationVariables(
+        store,
+        currentSlotHead,
+        FastConfirmationRuleUtil.getGreatestUnrealizedJustifiedCheckpoint(store.store()),
+        FastConfirmationRuleUtil.isStartSlotAtEpoch(spec, currentSlot),
+        FastConfirmationRuleUtil.isStartSlotAtEpoch(spec, currentSlot.plus(1)));
+  }
+
+  public static FastConfirmationStore evaluate(
+      final Spec spec,
+      final FastConfirmationStore updatedStore,
+      final UInt64 currentSlot,
+      final Optional<BeaconState> previousBalanceSource,
+      final BeaconState currentBalanceSource,
+      final BeaconState headBlockState) {
+    final FastConfirmationStates states =
+        new FastConfirmationStates(previousBalanceSource, currentBalanceSource, headBlockState);
+    final Bytes32 confirmedRoot =
+        new FastConfirmationCalculator(spec, updatedStore, states, currentSlot)
+            .getLatestConfirmed();
+    return updatedStore.withConfirmedRoot(confirmedRoot);
+  }
+}
