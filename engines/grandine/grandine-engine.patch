@@ -0,0 +1,656 @@
+use std::collections::HashMap;
+use std::sync::Arc;
+use std::time::Instant;
+
+use anyhow::{Context, Result, bail};
+use bls::{AggregateSignatureBytes, traits::SignatureBytes as _};
+use crossbeam_utils::sync::WaitGroup;
+use database::Database;
+use execution_engine::{PayloadStatusV1, PayloadValidationStatus};
+use fork_choice_control::{AdHocBenchController, MutatorHandle};
+use fork_choice_store::{AttestationItem, AttestationOrigin, StoreConfig};
+use helper_functions::{accessors, misc};
+use pubkey_cache::PubkeyCache;
+use ssz::{BitList, BitVector, SszReadDefault as _};
+use tracing::{info, warn};
+use types::{
+    combined::{Attestation, BeaconState, SignedBeaconBlock},
+    config::Config as ChainConfig,
+    electra::containers::Attestation as ElectraAttestation,
+    nonstandard::Phase,
+    phase0::{
+        containers::{Attestation as Phase0Attestation, AttestationData, Checkpoint},
+        primitives::{H256, Slot},
+    },
+    preset::{Mainnet, Preset},
+    traits::{BeaconState as _, SignedBeaconBlock as _},
+};
+
+use crate::config::{Config, Network};
+use crate::http::{BeaconFetcher, PlanAttestation, PlanBlockImport, fetch_slot_instruction};
+use crate::output::{OutputWriter, SlotResult};
+
+type P = Mainnet;
+
+pub struct Engine {
+    controller: Arc<AdHocBenchController<P>>,
+    _mutator_handle: MutatorHandle<P, WaitGroup>,
+    fetcher: BeaconFetcher,
+    block_cache: HashMap<Slot, Option<Arc<SignedBeaconBlock<P>>>>,
+    output: OutputWriter,
+    config: EngineConfig,
+    _db_dir: tempfile::TempDir,
+}
+
+struct EngineConfig {
+    start_slot: Slot,
+    end_slot: Slot,
+    warmup_start_slot: Slot,
+    beacon_node_url: String,
+}
+
+impl Engine {
+    pub async fn new(config: &Config) -> Result<Self> {
+        let chain_config = Arc::new(match config.network() {
+            Network::Mainnet => {
+                let mut c = ChainConfig::mainnet();
+                c.confirmation_byzantine_threshold = config.byzantine_threshold;
+                c
+            }
+        });
+
+        let start_slot = config.start_slot();
+        let end_slot = config.end_slot();
+        let warmup_start_slot = config.warmup_start_slot();
+
+        info!(
+            warmup_start_slot,
+            start_slot, end_slot, "Initializing Grandine FCR engine"
+        );
+
+        let fetcher = BeaconFetcher::new(config.beacon_node_url(), chain_config.clone())
+            .context("failed to create HTTP fetcher")?;
+
+        let warmup_state = fetcher.fetch_state_at_slot::<P>(warmup_start_slot).await?;
+        let finalized_cp = warmup_state.finalized_checkpoint();
+        info!(
+            finalized_epoch = %finalized_cp.epoch,
+            finalized_root = %format_root(finalized_cp.root),
+            "Read real finalized checkpoint from warmup state"
+        );
+
+        let expected_block_slot = misc::compute_start_slot_at_epoch::<P>(finalized_cp.epoch);
+        let scan_end_slot =
+            misc::compute_start_slot_at_epoch::<P>(finalized_cp.epoch.saturating_sub(1));
+        info!(
+            expected_block_slot,
+            scan_end_slot, "Scanning backward for finalized block"
+        );
+
+        let mut finalized_block_slot = None;
+        for slot in (scan_end_slot..=expected_block_slot).rev() {
+            let Some(block) = fetcher
+                .fetch_block_at_slot::<P>(slot)
+                .await
+                .with_context(|| {
+                    format!("failed to fetch finalized candidate block at slot {}", slot)
+                })?
+            else {
+                continue;
+            };
+
+            let block_root = block.message().hash_tree_root();
+            if block_root == finalized_cp.root {
+                finalized_block_slot = Some(slot);
+                break;
+            }
+        }
+
+        let Some(finalized_block_slot) = finalized_block_slot else {
+            bail!(
+                "finalized checkpoint block root {} was not found by scanning slots {} down to {}; orchestrator data may not include finalized_epoch {}",
+                format_root(finalized_cp.root),
+                expected_block_slot,
+                scan_end_slot,
+                finalized_cp.epoch,
+            );
+        };
+
+        info!(
+            finalized_block_slot = %finalized_block_slot,
+            "Fetched finalized block"
+        );
+
+        let (anchor_slot, anchor_state, anchor_block) =
+            find_epoch_aligned_anchor::<P>(&fetcher, finalized_block_slot)
+                .await
+                .context("failed to find epoch-aligned anchor")?;
+
+        info!(
+            anchor_slot,
+            warmup_start_slot,
+            catchup_slots = warmup_start_slot - anchor_slot,
+            "Selected epoch-aligned anchor",
+        );
+
+        let db_dir = tempfile::Builder::new()
+            .prefix("fcr-grandine-")
+            .rand_bytes(10)
+            .tempdir()
+            .context("failed to create temp DB dir")?;
+
+        let database = Database::in_memory();
+
+        let store_config = StoreConfig {
+            fast_confirmation_rule: true,
+            ..StoreConfig::default()
+        };
+
+        let pubkey_cache = Arc::new(PubkeyCache::default());
+        let anchor_block_arc = Arc::new(anchor_block);
+        let anchor_state_arc = Arc::new(anchor_state);
+
+        let (controller, mutator_handle) = AdHocBenchController::with_p2p_tx(
+            chain_config.clone(),
+            pubkey_cache,
+            store_config,
+            anchor_block_arc,
+            anchor_state_arc,
+            database,
+            futures::sink::drain(),
+        );
+
+        info!(
+            from = anchor_slot + 1,
+            to = warmup_start_slot,
+            "Catching up anchor to warmup_start_slot"
+        );
+        let mut catchup_blocks = 0u64;
+        for slot in (anchor_slot + 1)..=warmup_start_slot {
+            if misc::is_epoch_start::<P>(slot) {
+                info!(
+                    slot,
+                    epoch = misc::compute_epoch_at_slot::<P>(slot),
+                    "Warmup catchup crossed epoch boundary"
+                );
+            }
+
+            controller.on_slot(slot);
+            controller.wait_for_tasks();
+
+            if let Some(block) = fetcher
+                .fetch_block_at_slot::<P>(slot)
+                .await
+                .with_context(|| format!("failed to fetch catchup block at slot {}", slot))?
+            {
+                let block = Arc::new(block);
+                controller.on_replay_block(block.clone());
+                controller.wait_for_tasks();
+                promote_imported_payload_to_valid(&controller, block.as_ref());
+                catchup_blocks += 1;
+            }
+        }
+        info!(catchup_blocks, "Catchup complete");
+
+        let output =
+            OutputWriter::new(config.output()).context("failed to create JSONL output writer")?;
+
+        Ok(Self {
+            controller,
+            _mutator_handle: mutator_handle,
+            fetcher,
+            block_cache: HashMap::new(),
+            output,
+            config: EngineConfig {
+                start_slot,
+                end_slot,
+                warmup_start_slot,
+                beacon_node_url: config.beacon_node_url().to_string(),
+            },
+            _db_dir: db_dir,
+        })
+    }
+
+    pub async fn run(&mut self) -> Result<()> {
+        let mut slot = self.config.warmup_start_slot + 1;
+        let mut total_recorded = 0u64;
+        let run_start = Instant::now();
+
+        info!(
+            start_slot = slot,
+            end_slot = self.config.end_slot,
+            recording_from = self.config.start_slot,
+            "Entering simulation loop"
+        );
+
+        while slot < self.config.end_slot {
+            let is_recording = slot >= self.config.start_slot;
+            let slot_start = Instant::now();
+
+            self.controller.on_slot(slot);
+            self.controller.wait_for_tasks();
+
+            let instruction = fetch_slot_instruction(
+                &self.config.beacon_node_url,
+                slot,
+                self.config.warmup_start_slot,
+            )
+            .await
+            .with_context(|| format!("failed to fetch slot instruction for sim slot {}", slot))?;
+            if instruction.sim_slot != slot {
+                bail!(
+                    "slot instruction sim_slot mismatch: requested {}, got {}",
+                    slot,
+                    instruction.sim_slot
+                );
+            }
+
+            let (has_block, block_root) = self
+                .import_planned_blocks(slot, &instruction.import_blocks)
+                .await
+                .with_context(|| {
+                    format!("failed to import planned blocks for sim slot {}", slot)
+                })?;
+
+            let num_attestations_injected = self
+                .inject_attestations(slot, &instruction.attestations)
+                .with_context(|| {
+                    format!(
+                        "failed to inject {} planned attestations for sim slot {}",
+                        instruction.attestations.len(),
+                        slot
+                    )
+                })?;
+
+            let fcr_eval_start = Instant::now();
+            self.controller.on_slot(instruction.eval_slot);
+            self.controller.wait_for_tasks();
+            let fcr_eval_duration_us = micros_since(fcr_eval_start);
+
+            info!(
+                slot,
+                is_recording,
+                has_block,
+                num_attestations_injected,
+                fcr_eval_ms = fcr_eval_duration_us / 1000,
+                slot_ms = slot_start.elapsed().as_millis() as u64,
+                "slot done"
+            );
+
+            if is_recording {
+                let result = self.build_slot_result(
+                    slot,
+                    has_block,
+                    block_root,
+                    None,
+                    num_attestations_injected,
+                    fcr_eval_duration_us,
+                );
+                total_recorded += 1;
+                self.output.write(&result)?;
+                self.output.flush_if_needed(total_recorded)?;
+            }
+
+            slot += 1;
+        }
+
+        self.output.flush()?;
+
+        info!(
+            total_slots = total_recorded,
+            duration_secs = format!("{:.1}", run_start.elapsed().as_secs_f64()),
+            "Simulation complete"
+        );
+
+        Ok(())
+    }
+
+    async fn get_block_at_slot(&mut self, slot: Slot) -> Result<Option<Arc<SignedBeaconBlock<P>>>> {
+        if let Some(cached) = self.block_cache.get(&slot) {
+            return Ok(cached.clone());
+        }
+        let block = self
+            .fetcher
+            .fetch_block_at_slot::<P>(slot)
+            .await?
+            .map(Arc::new);
+        self.block_cache.insert(slot, block.clone());
+        Ok(block)
+    }
+
+    async fn import_planned_blocks(
+        &mut self,
+        sim_slot: Slot,
+        imports: &[PlanBlockImport],
+    ) -> Result<(bool, Option<H256>)> {
+        let canonical_root = imports
+            .iter()
+            .find(|import| import.canonical && import.slot == sim_slot)
+            .map(|import| import.root);
+
+        for import in imports {
+            let Some(block) = self.fetch_planned_block(import).await? else {
+                continue;
+            };
+
+            let block_root = block.message().hash_tree_root();
+            if block_root != import.root {
+                bail!(
+                    "planned block root mismatch for slot {}: plan {}, fetched {}",
+                    import.slot,
+                    format_root(import.root),
+                    format_root(block_root)
+                );
+            }
+            if block.message().slot() != import.slot {
+                bail!(
+                    "planned block slot mismatch for root {}: plan {}, fetched {}",
+                    format_root(import.root),
+                    import.slot,
+                    block.message().slot()
+                );
+            }
+
+            if self
+                .controller
+                .block_by_root(import.root)
+                .with_context(|| {
+                    format!("failed to check planned block {}", format_root(import.root))
+                })?
+                .is_some()
+            {
+                warn!(
+                    block_root = %format_root(import.root),
+                    slot = import.slot,
+                    canonical = import.canonical,
+                    "planned block was already known; skipping duplicate import"
+                );
+                continue;
+            }
+
+            self.controller.on_replay_block(block.clone());
+            self.controller.wait_for_tasks();
+
+            if self
+                .controller
+                .block_by_root(import.root)
+                .with_context(|| {
+                    format!(
+                        "failed to check imported block {}",
+                        format_root(import.root)
+                    )
+                })?
+                .is_some()
+            {
+                promote_imported_payload_to_valid(&self.controller, block.as_ref());
+            } else if import.canonical {
+                bail!(
+                    "planned canonical block {} at slot {} was not visible after import",
+                    format_root(import.root),
+                    import.slot
+                );
+            } else {
+                warn!(
+                    block_root = %format_root(import.root),
+                    slot = import.slot,
+                    "planned non-canonical block was not visible after import; skipping"
+                );
+            }
+        }
+
+        Ok((canonical_root.is_some(), canonical_root))
+    }
+
+    async fn fetch_planned_block(
+        &mut self,
+        import: &PlanBlockImport,
+    ) -> Result<Option<Arc<SignedBeaconBlock<P>>>> {
+        if import.canonical {
+            let block = self.get_block_at_slot(import.slot).await?;
+            return block.map(Some).with_context(|| {
+                format!(
+                    "planned canonical block at slot {} was not found",
+                    import.slot
+                )
+            });
+        }
+
+        match self
+            .fetcher
+            .fetch_block_by_root_optional::<P>(import.root)
+            .await?
+        {
+            Some(block) => Ok(Some(Arc::new(block))),
+            None => {
+                warn!(
+                    block_root = %format_root(import.root),
+                    slot = import.slot,
+                    "planned non-canonical block was not found; skipping"
+                );
+                Ok(None)
+            }
+        }
+    }
+
+    fn inject_attestations(&self, sim_slot: Slot, attestations: &[PlanAttestation]) -> Result<u64> {
+        if attestations.is_empty() {
+            return Ok(0);
+        }
+
+        let mut items = Vec::with_capacity(attestations.len());
+        for planned_attestation in attestations {
+            let attestation = self.build_attestation(planned_attestation)?;
+            let beacon_block_root = attestation.data().beacon_block_root;
+            items.push(AttestationItem::unverified(
+                Arc::new(attestation),
+                AttestationOrigin::Block(beacon_block_root),
+            ));
+        }
+
+        let accepted = self.controller.replay_attestations(items);
+        info!(
+            sim_slot,
+            planned_attestations = attestations.len(),
+            accepted_attestations = accepted,
+            "Injected planned attestations"
+        );
+
+        Ok(accepted as u64)
+    }
+
+    fn build_attestation(&self, planned: &PlanAttestation) -> Result<Attestation<P>> {
+        let data = AttestationData {
+            slot: planned.data.slot,
+            index: planned.data.index,
+            beacon_block_root: planned.data.beacon_block_root,
+            source: Checkpoint {
+                epoch: planned.data.source.epoch,
+                root: planned.data.source.root,
+            },
+            target: Checkpoint {
+                epoch: planned.data.target.epoch,
+                root: planned.data.target.root,
+            },
+        };
+
+        match self.controller.chain_config().phase_at_slot::<P>(data.slot) {
+            Phase::Electra | Phase::Fulu | Phase::Gloas => {
+                let committee_bits = planned
+                    .committee_bits
+                    .as_deref()
+                    .context("electra attestation is missing committee_bits")?;
+
+                Ok(Attestation::Electra(ElectraAttestation {
+                    aggregation_bits:
+                        BitList::<<P as Preset>::MaxAttestersPerSlot>::from_ssz_default(
+                            &planned.aggregation_bits,
+                        )
+                        .map_err(|e| {
+                            anyhow::anyhow!("failed to decode electra aggregation_bits: {:?}", e)
+                        })?,
+                    data,
+                    signature: AggregateSignatureBytes::empty(),
+                    committee_bits:
+                        BitVector::<<P as Preset>::MaxCommitteesPerSlot>::from_ssz_default(
+                            committee_bits,
+                        )
+                        .map_err(|e| {
+                            anyhow::anyhow!("failed to decode electra committee_bits: {:?}", e)
+                        })?,
+                }))
+            }
+            Phase::Phase0 | Phase::Altair | Phase::Bellatrix | Phase::Capella | Phase::Deneb => {
+                Ok(Attestation::Phase0(Phase0Attestation {
+                    aggregation_bits:
+                        BitList::<<P as Preset>::MaxValidatorsPerCommittee>::from_ssz_default(
+                            &planned.aggregation_bits,
+                        )
+                        .map_err(|e| {
+                            anyhow::anyhow!("failed to decode phase0 aggregation_bits: {:?}", e)
+                        })?,
+                    data,
+                    signature: AggregateSignatureBytes::empty(),
+                }))
+            }
+        }
+    }
+
+    fn build_slot_result(
+        &self,
+        slot: Slot,
+        has_block: bool,
+        block_root: Option<H256>,
+        source_block_slot: Option<Slot>,
+        num_attestations_injected: u64,
+        fcr_eval_duration_us: u64,
+    ) -> SlotResult {
+        let head = self.controller.head().value;
+        let head_root = head.block_root;
+
+        let justified_epoch = self.controller.justified_checkpoint().epoch;
+        let finalized_epoch = self.controller.finalized_epoch();
+
+        let (confirmed_root, confirmed_slot) = match self.controller.confirmed_root() {
+            Some(root) if root != H256::zero() => {
+                let slot = self
+                    .controller
+                    .block_by_root(root)
+                    .ok()
+                    .flatten()
+                    .map(|with_status| with_status.value.message().slot())
+                    .unwrap_or(0);
+                (root, slot)
+            }
+            _ => (H256::zero(), 0),
+        };
+
+        let fast_confirmed = confirmed_root != H256::zero() && confirmed_slot == slot;
+        let eval_slot = slot.saturating_add(1);
+        let delay = eval_slot.saturating_sub(confirmed_slot);
+        let strict_one_slot_confirmed = has_block
+            && confirmed_root != H256::zero()
+            && block_root == Some(confirmed_root)
+            && confirmed_slot == slot
+            && delay == 1;
+
+        SlotResult {
+            slot,
+            epoch: misc::compute_epoch_at_slot::<P>(slot),
+            has_block,
+            block_root: block_root.map(format_root),
+            head_root: format_root(head_root),
+            confirmed_root: format_root(confirmed_root),
+            confirmed_slot,
+            confirmation_delay_slots: delay,
+            fast_confirmed,
+            strict_one_slot_confirmed,
+            finalized_epoch,
+            justified_epoch,
+            source_block_slot,
+            num_attestations_injected,
+            is_epoch_boundary: misc::is_epoch_start::<P>(slot),
+            is_missed_slot: !has_block,
+            fcr_eval_duration_us,
+        }
+    }
+}
+
+async fn find_epoch_aligned_anchor<P: Preset>(
+    fetcher: &BeaconFetcher,
+    warmup_start_slot: Slot,
+) -> Result<(Slot, BeaconState<P>, SignedBeaconBlock<P>)> {
+    let initial_epoch = misc::compute_epoch_at_slot::<P>(warmup_start_slot);
+    for epoch in (0..=initial_epoch).rev() {
+        let epoch_slot = misc::compute_start_slot_at_epoch::<P>(epoch);
+        match fetcher.fetch_block_at_slot::<P>(epoch_slot).await {
+            Ok(Some(block)) => {
+                let state = fetcher
+                    .fetch_state_at_slot::<P>(epoch_slot)
+                    .await
+                    .with_context(|| {
+                        format!("failed to fetch state at anchor slot {}", epoch_slot)
+                    })?;
+                // Sanity: state.latest_block_root must equal block.hash_tree_root.
+                let latest = accessors::latest_block_root(&state);
+                let block_root = block.message().hash_tree_root();
+                if latest != block_root {
+                    warn!(
+                        epoch_slot,
+                        latest = ?latest,
+                        block_root = ?block_root,
+                        "anchor state's latest_block_root != block.root; skipping",
+                    );
+                    continue;
+                }
+                return Ok((epoch_slot, state, block));
+            }
+            Ok(None) => continue,
+            Err(e) => {
+                warn!(epoch_slot, error = ?e, "failed to fetch candidate anchor block; trying earlier epoch");
+                continue;
+            }
+        }
+    }
+    bail!(
+        "no epoch-aligned non-missed slot found at or before warmup_start_slot {}",
+        warmup_start_slot
+    )
+}
+
+fn format_root(root: H256) -> String {
+    format!("0x{}", hex::encode(root))
+}
+
+fn promote_imported_payload_to_valid<P: Preset>(
+    controller: &AdHocBenchController<P>,
+    block: &SignedBeaconBlock<P>,
+) {
+    let Some(payload) = block
+        .message()
+        .body()
+        .with_execution_payload()
+        .map(|body| body.execution_payload())
+    else {
+        return;
+    };
+
+    let block_hash = payload.block_hash();
+    if block_hash == Default::default() {
+        return;
+    }
+
+    controller.on_notified_new_payload(
+        block.message().hash_tree_root(),
+        block_hash,
+        PayloadStatusV1 {
+            status: PayloadValidationStatus::Valid,
+            latest_valid_hash: Some(block_hash),
+            validation_error: None,
+        },
+    );
+    controller.wait_for_tasks();
+}
+
+fn micros_since(start: Instant) -> u64 {
+    start.elapsed().as_micros().min(u128::from(u64::MAX)) as u64
+}
