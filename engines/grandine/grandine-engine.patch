+        let mut accepted = 0;
+        let results: Vec<VerifyAttestationResult<P>> = attestations
+            .into_iter()
+            .map(|attestation| {
+                let result = snapshot.validate_attestation(attestation, false);
+                if matches!(&result, Ok(AttestationAction::Accept { .. })) {
+                    accepted += 1;
+                }
+                result
+            })
+            .collect();
+
+        self.on_attestation_batch(results);
+        self.wait_for_tasks();
+
